  "item": [
    {
      "name": "Listar todas las solicitudes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/solicitudes",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","solicitudes"]
        }
      }
    },
    {
      "name": "Obtener solicitud por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/solicitudes/{{id}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","solicitudes","{{id}}"]
        }
      }
    },
    {
      "name": "Crear nueva solicitud",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreSolicitante\": \"Lucía Fernández\",\n  \"importeSolicitado\": 12000,\n  \"divisa\": \"EUR\",\n  \"documentoIdentificativo\": \"55667788D\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/solicitudes",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","solicitudes"]
        }
      }
    },
    {
      "name": "Actualizar estado de solicitud",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"APROBADA\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/solicitudes/{{id}}/estado",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","solicitudes","{{id}}","estado"]
        }
      }
    }
  ],
  "variable": [
